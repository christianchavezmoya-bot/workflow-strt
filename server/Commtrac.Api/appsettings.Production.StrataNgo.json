{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Postgres",
    "RunMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_PROD_RDS_HOST.ap-southeast-2.rds.amazonaws.com;Database=commtrac;Username=commtrac;Password=SET_VIA_SECRETS_MANAGER"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.strata-ngo.com"
    ],
    "AllowDeviceOrigins": false
  },
  "Storage": {
    "Provider": "S3",
    "Bucket": "strata-ngo-media-prod",
    "Region": "ap-southeast-2",
    "KeyPrefix": "commtrac-prod"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "commtrac",
    "Audience": "commtrac-ui",
    "ExpiresMinutes": 1440
  },
  "SeedProfile": "StrataNgo",
  "SeedAdmin": {
    "Email": "admin@StrataNgo.local",
    "Password": "",
    "FullName": "Strata Admin"
  },
  "SeedProjectManager": {
    "Email": "project.manager@StrataNgo.local",
    "Password": "",
    "FullName": "Project Manager"
  },
  "Email": {
    "FrontendBaseUrl": "https://www.strata-ngo.com"
  },
  "Build": {
    "GitSha": "",
    "BuiltAt": ""
  }
}
