# Production web build — set before `npm run build`
# Baked into the static bundle; use your public API URL (HTTPS).
VITE_API_BASE=https://api.yourdomain.com/api

# Feature flags: VITE_ENABLE_BOM_MODULE is NOT read from env files for store/cloud production builds.
# `build-cloud-web.mjs --profile prod` pins it from scripts/build-profiles.mjs (features.bomModule)
# and fails the build if the compiled bundle disagrees. Only a plain `npm run build` reads it from here.
