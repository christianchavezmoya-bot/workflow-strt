# DEV (staging AWS):
#   VITE_API_BASE=https://api.staging.strata-ngo.com/api
#   VITE_APP_ENV=dev
#
# PRODUCTION (after Phase C/F cutover):
#   VITE_API_BASE=https://api.strata-ngo.com/api
#   VITE_APP_ENV=prod

VITE_API_BASE=https://api.staging.strata-ngo.com/api
VITE_APP_ENV=dev
