<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>N-Go DEV</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your secure session when offline.</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is required to photograph inspection evidence and assets.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access is required when recording video evidence for workflow runs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo library access is required to attach existing photos to inspection runs.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Permission is needed to save inspection photos to your photo library.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Production: HTTPS-only. NSAllowsLocalNetworking permits only loopback/local-network
		     requests (e.g. the LocalMediaServerPlugin's 127.0.0.1 video-streaming server) without
		     weakening ATS for any real internet host — it does not allow arbitrary cleartext to
		     the production API or any other remote domain. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance: standard HTTPS/TLS transport plus HMAC/ECDSA JWT
	     signing used only for authentication/integrity — no proprietary or
	     third-party encryption anywhere in the app (see the crypto audit).
	     Declaring this avoids the manual "Missing Compliance" step in App
	     Store Connect on every future build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
