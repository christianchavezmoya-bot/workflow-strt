{
  "name": "commtrac-project-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloud-web": "node scripts/build-cloud-web.mjs",
    "build:cloud-web:staging": "node scripts/build-cloud-web.mjs --staging",
    "build:cloud-native": "node scripts/build-cloud-native.mjs",
    "build:cloud-native:staging": "node scripts/build-cloud-native.mjs --staging",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "test:e2e:perf": "playwright test --config playwright.perf.config.ts",
    "test:e2e:pm-smoke": "playwright test --config playwright.pm-field.config.ts",
    "test:e2e:workflow-consistency": "playwright test --config playwright.workflow-consistency.config.ts",
    "test:e2e:web-perf": "playwright test --config playwright.web-perf.config.ts",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "perf:baseline:record": "node scripts/perf-baseline.mjs record",
    "perf:baseline:compare": "node scripts/perf-baseline.mjs compare",
    "release-gates": "node .claude/skills/enterprise-dev-practices/scripts/check-gates.mjs typecheck backend test e2e e2eperf",
    "version:sync": "node scripts/sync-version.mjs",
    "gates": "node .claude/skills/enterprise-dev-practices/scripts/check-gates.mjs",
    "postinstall": "node scripts/patch-biometric-spm.cjs && node scripts/install-githooks.mjs",
    "docs:update": "node scripts/update-architecture-docs.mjs",
    "hooks:install": "node scripts/install-githooks.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.1",
    "@cyntler/react-doc-viewer": "^1.17.1",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.3",
    "@hookform/resolvers": "^3.3.4",
    "@ionic/pwa-elements": "^3.4.0",
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.18",
    "@mui/x-date-pickers": "^8.26.0",
    "@reduxjs/toolkit": "^2.2.6",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.6.8",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.19",
    "docx": "^9.6.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.5.207",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.4",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.22.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.9.4",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
