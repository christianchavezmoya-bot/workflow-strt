# Production API endpoint — REQUIRED for mobile builds and deployed web.
# Replace with your actual server URL before running: npm run build
# Examples:
#   https://api.yourdomain.com/api          (cloud / VPS deployment)
#   http://192.168.1.104:4000/api           (LAN, same network as device)
# Set your LAN/cloud API URL before building (e.g. http://10.7.15.155:4000/api)
VITE_API_BASE=http://10.7.15.155:4000/api



