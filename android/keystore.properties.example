# Strata N-Go — Android release signing (upload key)
#
# Copy this file to `keystore.properties` (same directory, git-ignored) and fill
# in real values once the upload keystore exists. Do NOT commit the real file.
#
# storeFile may be an absolute path, or relative to this `android/` directory.
# Do NOT point this at ~/.android/genia-upload.keystore — that key is unrelated
# to Strata N-Go and must not be reused for this app.

storeFile=/absolute/path/to/strata-ngo-upload.keystore
storePassword=CHANGE_ME
keyAlias=strata-ngo-upload
keyPassword=CHANGE_ME
