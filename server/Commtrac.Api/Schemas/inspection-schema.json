{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "commtrac:inspection-import:v1",
  "title": "Commtrac Canonical Inspection Import",
  "description": "Canonical format for inspection results imported into Commtrac. All external adapters must produce this structure.",
  "type": "object",
  "required": ["inspectionDate"],
  "properties": {
    "inspectionDate": {
      "type": "string",
      "description": "ISO 8601 date or datetime when the inspection was performed e.g. '2026-05-20' or '2026-05-20T14:30:00Z'",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "technicianName": {
      "type": "string",
      "description": "Full name of the technician or inspector"
    },
    "assetTag": {
      "type": "string",
      "description": "Asset tag or identifier for cross-validation when assigning to a project asset"
    },
    "notes": {
      "type": "string",
      "description": "Overall inspection notes or summary"
    },
    "results": {
      "type": "array",
      "description": "Individual check or measurement results. checkId should match the workflow step ID.",
      "items": {
        "type": "object",
        "required": ["checkId"],
        "properties": {
          "checkId": {
            "type": "string",
            "description": "Identifier for this check — matches the workflow step ID when wiring to a run"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label e.g. 'Insulation Resistance Test'"
          },
          "value": {
            "type": "string",
            "description": "Measured or observed value as a string e.g. '500', 'PASS', '23.4'"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement e.g. 'MOhm', 'V', 'A', '°C'"
          },
          "pass": {
            "type": ["boolean", "null"],
            "description": "true = passed, false = failed, null = not applicable"
          },
          "notes": {
            "type": "string",
            "description": "Per-check notes or observations"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "inspectionDate": "2026-05-20",
      "technicianName": "John Smith",
      "assetTag": "RC0011",
      "notes": "All electrical checks passed. Minor corrosion noted on terminal block.",
      "results": [
        { "checkId": "insulation-resistance", "label": "Insulation Resistance", "value": "520", "unit": "MOhm", "pass": true },
        { "checkId": "earth-continuity",      "label": "Earth Continuity",      "value": "0.12", "unit": "Ohm", "pass": true },
        { "checkId": "supply-voltage",        "label": "Supply Voltage",        "value": "415",  "unit": "V",   "pass": true },
        { "checkId": "visual-check",          "label": "Visual Check",          "value": "Minor corrosion on terminal block", "pass": false, "notes": "Logged as low-priority observation" },
        { "checkId": "functional-test",       "label": "Functional Test",       "value": "PASS", "pass": true }
      ]
    }
  ]
}
