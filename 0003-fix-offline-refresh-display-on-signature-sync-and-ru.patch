From a9bf4b7b0b2cf590b61f5147dc038a712dd1c88f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 8 Jul 2026 06:03:04 +0000
Subject: [PATCH] fix(offline): refresh display on signature-sync and
 run-create-sync; mergeById on online signature
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Completes the refresh-signal coverage found across review. Same root cause as the
prior two offline commits (a run write that doesn't signal the Assets page, or a
single-run update that replaces the whole list):

1. signatureService online signature-success path dispatched without mergeById
   (replaced the asset's run list) — now mergeById, preserving siblings.
2. useSyncEngine SIGNATURE_SUBMIT sync branch saved the signed run but dispatched
   NO refresh event — after a queued signature synced online, the display didn't
   update. Now dispatches (mergeById). Extracted the run to a const with
   localStatus "Synced" as const (tsc).
3. useSyncEngine processRunCreateAction saved the synced created-run but dispatched
   no refresh — now dispatches (mergeById) after id-remap completes.

Deliberately NOT dispatching on the transient sync-status markers
(localStatus "Syncing"/"FailedSync" at useSyncEngine ~237/249) — those aren't
user-facing content changes and a refresh there would risk flicker.
markRunSyncedFromServer (~136) already refreshes via its caller.

Client-only, no backend. Two files. tsc -b + build clean. Needs device
verification (offline signature → sync → display refreshes; siblings preserved).
---
 src/hooks/useSyncEngine.ts       | 15 ++++++++++++---
 src/services/signatureService.ts |  2 +-
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/src/hooks/useSyncEngine.ts b/src/hooks/useSyncEngine.ts
index 6b677a4..af66928 100644
--- a/src/hooks/useSyncEngine.ts
+++ b/src/hooks/useSyncEngine.ts
@@ -178,6 +178,10 @@ async function processRunCreateAction(action: PendingAction, responseData: unkno
     await syncQueue.replaceRunIdReferences(action.entityId, serverRun.id);
     await offlineStore.deleteRun(action.entityId);
   }
+  // Refresh the display after a created run syncs (mergeById preserves siblings).
+  window.dispatchEvent(new CustomEvent("workflow-runs-cache-updated", {
+    detail: { assetId: mergedRun.assetId, runs: [mergedRun], mergeById: true },
+  }));
 }
 
 async function processWorkInstructionCreateAction(action: PendingAction, responseData: unknown): Promise<void> {
@@ -292,16 +296,21 @@ async function processSyncedAction(action: PendingAction, responseData: unknown)
     const payload = action.body as { signerRole?: "Installer" | "Customer" } | undefined;
     if (cachedRun && payload?.signerRole) {
       const signedAt = signature?.signedAtUtc ?? new Date().toISOString();
-      await offlineStore.saveRun({
+      const syncedSignedRun = {
         ...cachedRun,
         installerSignedAt: payload.signerRole === "Installer" ? signedAt : cachedRun.installerSignedAt,
         customerSignedAt: payload.signerRole === "Customer" ? signedAt : cachedRun.customerSignedAt,
         signatureStatus: payload.signerRole === "Customer" ? "Signed" : (cachedRun.customerSignedAt ? "Signed" : "PendingCustomer"),
-        localStatus: "Synced",
+        localStatus: "Synced" as const,
         dirty: false,
         syncError: undefined,
         lastLocalSavedAt: signedAt,
-      });
+      };
+      await offlineStore.saveRun(syncedSignedRun);
+      // Refresh the display after a signature syncs (mergeById preserves siblings).
+      window.dispatchEvent(new CustomEvent("workflow-runs-cache-updated", {
+        detail: { assetId: syncedSignedRun.assetId, runs: [syncedSignedRun], mergeById: true },
+      }));
     }
     return;
   }
diff --git a/src/services/signatureService.ts b/src/services/signatureService.ts
index 0f2a124..0368999 100644
--- a/src/services/signatureService.ts
+++ b/src/services/signatureService.ts
@@ -95,7 +95,7 @@ export const signatureService = {
         };
         await offlineStore.saveRun(updatedRun);
         window.dispatchEvent(new CustomEvent("workflow-runs-cache-updated", {
-          detail: { assetId: updatedRun.assetId, runs: [updatedRun] },
+          detail: { assetId: updatedRun.assetId, runs: [updatedRun], mergeById: true },
         }));
       }
       window.dispatchEvent(new Event("notifications:run-state-changed"));
--
