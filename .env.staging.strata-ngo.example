# Strata NGO — AWS staging (Sydney)
# Copy to .env.staging.local (git-ignored) before cloud web/native builds.
VITE_API_BASE=https://api.staging.strata-ngo.com/api

VITE_ENABLE_BOM_MODULE=true

# Optional: skip Face ID / PIN gate on native device builds (Xcode testing).
# When true, App logs auth mode "biometric-skipped" and enters the app directly.
# VITE_SKIP_BIOMETRIC=true
